# Optional. Copy to .env in this directory only if you need one of these.
# The fixture works with every value here unset -- the defaults in
# docker-compose.yml are throwaway passwords for throwaway databases.

# Gaseous enriches metadata from IGDB. Romarr never reads IGDB, and all four
# of its questions are answered with these empty, so leave them blank unless
# you are specifically testing Gaseous metadata.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Only worth setting if something else on the host already owns these
# databases. Nothing outside this compose project reads them.
GASEOUS_DB_PASSWORD=gaseous
RETROM_DB_PASSWORD=retrom
