{
  "manifest_version": 3,
  "name": "ROMarr Server Launcher",
  "version": "1.0.0",
  "description": "Save your ROMarr server addresses and open library, queue and settings in Chrome.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open ROMarr"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "102"
}
