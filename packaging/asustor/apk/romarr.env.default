# ROMarr on Asustor. Edit, then restart ROMarr in App Central.
#
# The user that should own the games ROMarr files. The first user you create
# in ADM is 1000 and "users" is 100; check yours over SSH with `id <user>`.
PUID=1000
PGID=100
TZ=Etc/UTC
# Settings, history, API key and plugins. Back it up.
ROMARR_CONFIG=/share/Docker/romarr/config
# Your game library: the folder RomM, Gaseous or your frontend reads.
# Created on first start if it is the default below; otherwise it must exist.
ROMARR_ROMS=/share/Media/Games
# Your download client's completed folder, mounted at the same path inside
# the container (Download Center reports /share/Download). Must exist.
ROMARR_DOWNLOADS=/share/Download
ROMARR_HOST_PORT=6868
