# ROMarr on QNAP. Edit, then restart ROMarr in App Center.
#
# The user that should own the games ROMarr files. 1000 is the first user
# created after admin and 100 is "everyone". Check yours over SSH with
# `id <user>`. Do not use 0: games would land owned by root.
PUID=1000
PGID=100
TZ=Etc/UTC
# Settings, history, API key and plugins. Created if missing. Back it up.
ROMARR_CONFIG=/share/Container/romarr
# Your game library: the shared folder RomM, Gaseous or your frontend reads.
# Must already exist.
ROMARR_ROMS=/share/Multimedia/Games
# Your download client's completed folder, mounted at the same path inside
# the container (Download Station reports /share/Download). Must exist.
ROMARR_DOWNLOADS=/share/Download
ROMARR_HOST_PORT=6868
