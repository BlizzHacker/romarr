# ROMarr, browser edition -- the same app on Debian, with the Playwright client.
#
# Why this exists: the default image is Alpine (musl), and Playwright ships only
# glibc wheels, so `pip install playwright` inside it can never succeed ("no
# matching distribution"; issue #35). The Headless Browser download client
# needs that package in the ROMarr process even when the browser itself runs
# elsewhere, so a musl image cannot use it at all.
#
# This image carries ONLY the Python client. It deliberately has no Chromium:
# point Settings -> Download Clients -> Browser Host at a `playwright run-server`
# (for example the official mcr.microsoft.com/playwright image), or run
# `playwright install --with-deps chromium` yourself if you want one in here.
# Tag: ghcr.io/blizzhacker/romarr:browser  (and :<version>-browser)

FROM python:3.13-slim

ARG TARGETARCH
# Must match the playwright run-server you point at (client/server skew is the
# first thing to check if the connection stops working). See docs/PROOF.md.
ARG PLAYWRIGHT_VERSION=1.62.0

# gosu is su-exec's Debian twin and takes the same "uid:gid cmd" arguments, so
# the shared entrypoint runs unchanged under the su-exec name.
# unar (LGPL, Debian main) joins RAR releases split into volumes, which bsdtar
# cannot; romarr/library.py::rar_tool prefers it over bsdtar for .rar. Alpine
# has no package that joins split RAR sets (its 7zip is built without RAR),
# so the standard image explains how to add one instead.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        gosu tzdata libarchive-tools libseccomp2 git ca-certificates unar \
 && ln -s "$(command -v gosu)" /usr/local/bin/su-exec \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
 && pip install --no-cache-dir "playwright==${PLAYWRIGHT_VERSION}" \
 && if [ "$TARGETARCH" != "arm" ]; then \
      pip install --no-cache-dir \
        "rom-hub @ https://github.com/BlizzHacker/rom-hub/archive/02e9a1dbc7ebca5191b4a977233a4d6d0466ed4b.tar.gz"; \
    fi

WORKDIR /app
COPY romarr/ /app/romarr/

# Same baked-in version as the Alpine image; see romarr/version.py.
ARG ROMARR_VERSION=""
RUN printf '__version__ = "%s"\n' "${ROMARR_VERSION:-0.0.0+unknown}" \
    > /app/romarr/_version.py

# Diagnostic build provenance. Non-tag builds retain the unknown release
# version while carrying their exact source revision (no fabricated release).
ARG ROMARR_BUILD_KIND="unknown"
ARG ROMARR_SOURCE_REF=""
ARG ROMARR_SOURCE_REVISION=""
ARG ROMARR_SOURCE_REPOSITORY=""
RUN python -c 'import os, pathlib; keys = ("ROMARR_BUILD_KIND", "ROMARR_SOURCE_REF", "ROMARR_SOURCE_REVISION", "ROMARR_SOURCE_REPOSITORY"); values = {k.lower(): os.environ.get(k, "") for k in keys}; pathlib.Path("/app/romarr/_build_info.py").write_text("".join(k + " = " + repr(v) + "\n" for k, v in values.items()), encoding="utf-8")'
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /config /roms

ENV ROMARR_DATA=/config/romarr.json \
    ROM_HUB_HOME=/config/rom-hub \
    ROMARR_PORT=6868 \
    PUID=1000 \
    PGID=1000 \
    UMASK=002 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

VOLUME /config
EXPOSE 6868

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('ROMARR_PORT','6868')+'/api/health',timeout=4)"

LABEL org.opencontainers.image.title="ROMarr (browser edition)" \
      org.opencontainers.image.description="ROMarr on Debian with the Playwright client, for the Headless Browser download client" \
      org.opencontainers.image.source="https://github.com/BlizzHacker/romarr" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="${ROMARR_SOURCE_REVISION}"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-m", "romarr"]
